# Application
APP_NAME=SHAKTHI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://neondb_owner:npg_zP7ycLQgn2jf@ep-summer-forest-at01egs4.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Authentication
# JWT Authentication
JWT_SECRET_KEY=AFDb2x6FRWl13mLclZzi5SZvfXBpKLVH
JWT_REFRESH_SECRET_KEY=QItDqQznG9SD6O7K7EffonzCdtx2raGj
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI/LLM API Keys
GEMINI_API_KEY=AIzaSyB01d9XyvGiugiaeS-DkRkpP3lZS9tgqzM
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Primary AI Provider (gemini, openai, groq)
PRIMARY_AI_PROVIDER=gemini

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://shakthi.vercel.app
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Client-Info,Apikey

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@shakthi.app
SMTP_FROM_NAME=SHAKTHI

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf

# Safety Settings
SAFETY_REPORT_AUTO_ESCALATE_SEVERITY=URGENT
SAFETY_TICKET_PREFIX=SAF

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function}:{line} | {message}

# External Services
FRONTEND_URL=http://localhost:3000
